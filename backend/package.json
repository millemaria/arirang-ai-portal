{
  "name": "arirang-ai-portal-backend",
  "version": "1.0.0",
  "description": "ARMY Portal Fastify Backend with Clean Architecture",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:setup": "prisma generate && prisma db push && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@langchain/community": "^0.3.41",
    "@langchain/core": "^0.3.44",
    "@langchain/google-genai": "^0.2.12",
    "@prisma/client": "^6.6.0",
    "chromadb": "^1.9.2",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.6.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
